<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: lightgrey;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proj2ui.Controllers.FavoritesPageController">
   <children>
      <Label layoutX="189.0" layoutY="62.0" text="Lista de Favoritos">
         <font>
            <Font name="System Bold" size="27.0" />
         </font>
      </Label>
      <Button fx:id="goBackButton" layoutX="14.0" layoutY="367.0" mnemonicParsing="false" onAction="#goBackPage" prefHeight="25.0" prefWidth="73.0" text="Voltar" />
      <TableView fx:id="favoritesTableView" layoutX="224.0" layoutY="120.0" prefHeight="200.0" prefWidth="153.0">
        <columns>
          <TableColumn fx:id="teamColumn" prefWidth="75.0" text="Equipa" />
          <TableColumn fx:id="playerColumn" prefWidth="75.0" text="Jogador" />
        </columns>
      </TableView>
      <Button fx:id="addFavButton" layoutX="62.0" layoutY="187.0" mnemonicParsing="false" onAction="#goToAddFavPage" text="Adicionar Favorito" />
   </children>
</AnchorPane>
