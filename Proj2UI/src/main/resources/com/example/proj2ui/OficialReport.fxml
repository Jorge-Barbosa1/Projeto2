<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: lightgrey;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proj2ui.Controllers.OficialReportController">
   <children>
      <Label layoutX="162.0" layoutY="59.0" text="Lançar Resumo oficial">
         <font>
            <Font name="System Bold" size="27.0" />
         </font>
      </Label>
      <Button fx:id="goBackButton" layoutX="14.0" layoutY="361.0" mnemonicParsing="false" onAction="#goBack" text="Voltar" />
      <Label layoutX="110.0" layoutY="150.0" text="Esolha o Id do Jogo" />
      <Label layoutX="300.0" layoutY="150.0" text="Escreva o Relatório oficial" />
      <ComboBox fx:id="gamesIdComboBox" layoutX="107.0" layoutY="175.0" prefHeight="25.0" prefWidth="111.0" />
      <TextArea fx:id="reportTextArea" layoutX="268.0" layoutY="167.0" prefHeight="120.0" prefWidth="200.0" />
      <Button fx:id="sendOficialReportButton" layoutX="229.0" layoutY="303.0" mnemonicParsing="false" onAction="#sendOfficialReport" prefHeight="25.0" prefWidth="78.0" text="Enviar" />
   </children>
</AnchorPane>
